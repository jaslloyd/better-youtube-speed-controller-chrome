{
  "manifest_version": 3,
  "name": "Better Youtube Video Speed Controller",
  "version": "0.1.0",
  "description": "Control video playback speed on youtube",
  "permissions": ["activeTab", "scripting", "storage"],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  }
}
